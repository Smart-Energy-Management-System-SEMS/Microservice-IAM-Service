{
  "info": {
    "name": "SEMS IAM Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/auth/register" },
        "body": { "mode": "raw", "raw": "{\n  \"emailAddress\": \"user@email.com\",\n  \"password\": \"123456\",\n  \"role\": \"RESIDENT\"\n}" }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/auth/login" },
        "body": { "mode": "raw", "raw": "{\n  \"emailAddress\": \"user@email.com\",\n  \"password\": \"123456\"\n}" }
      }
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/api/v1/users/me" }
      }
    },
    {
      "name": "List Users (ADMIN)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/api/v1/users" }
      }
    },
    {
      "name": "Assign Role (ADMIN)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}/roles" },
        "body": { "mode": "raw", "raw": "{\n  \"role\": \"ADMIN\"\n}" }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" }
  ]
}
