# Service runtime
SERVER_PORT=8080
CONFIG_SERVICE_URL=http://localhost:8090
CONFIG_SERVICE_TIMEOUT_MS=3000

# Database (sensitive)
DB_URL=jdbc:postgresql://your-db-host:5432/postgres?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT (sensitive)
JWT_SECRET=your_jwt_secret_min_32_chars

# OAuth Google (sensitive)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional local overrides when Config Service is unavailable
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
# KAFKA_SSL_CA_CERT=
# KAFKA_CONSUMER_GROUP_ID=iam-service
# IAM_DEPLOY_URL=http://localhost:8080
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
# GOOGLE_SCOPES=openid,email,profile
