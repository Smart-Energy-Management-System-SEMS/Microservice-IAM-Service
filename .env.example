# Prefer Session Pooler (IPv4 compatible)
# Replace with value from Supabase -> Database -> Pooler settings
DB_URL=jdbc:postgresql://your-pooler-host:5432/postgres?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# If your network supports IPv6, you can use direct connection instead:
# DB_URL=jdbc:postgresql://your-direct-host:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=your_db_password

JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRATION_MINUTES=120
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=iam-service
SERVER_PORT=8080
GATEWAY_PORT=8081
IAM_PORT=8080
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_SCOPES=openid,email,profile
IAM_DEPLOY_URL=http://localhost:8080
