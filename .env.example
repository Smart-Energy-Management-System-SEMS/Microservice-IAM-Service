# Runtime
PORT=8080
SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=prod

# External services/config
CONFIG_SERVICE_URL=
CONFIG_SERVICE_TIMEOUT_MS=3000

# Kafka
KAFKA_ENABLED=true
KAFKA_AUTO_CREATE_TOPICS=false
KAFKA_BROKERS=
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=
TOPIC_IAM_EVENTS=iam.events

# Database / Auth
DATABASE_URL=
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres
JWT_SECRET=

# Existing service variables (keep compatibility)
API_GATEWAY_AUTH_REQUIRED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8082/api/v1/auth/google/callback
GOOGLE_SCOPES=openid,email,profile
IAM_DEPLOY_URL=http://localhost:8082
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_CONSUMER_GROUP_ID=iam-service

# API Gateway-only variables (not used by IAM directly)
IAM_SERVICE_URL=
DEVICE_MANAGEMENT_SERVICE_URL=
ALERT_SERVICE_URL=
SUBSCRIPTIONS_SERVICE_URL=
PAYMENTS_SERVICE_URL=
ANALYTICS_SERVICE_URL=
ENERGY_MONITORING_SERVICE_URL=
