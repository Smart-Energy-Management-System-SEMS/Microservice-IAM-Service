# Prefer Session Pooler (IPv4 compatible)
# Replace with value from Supabase -> Database -> Pooler settings
DB_URL=jdbc:postgresql://your-pooler-host:5432/postgres?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# If your network supports IPv6, you can use direct connection instead:
# DB_URL=jdbc:postgresql://your-direct-host:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=your_db_password

JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRATION_MINUTES=120
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=your-aiven-bootstrap-server
KAFKA_BROKERS=your-aiven-bootstrap-server
KAFKA_HOST=your-aiven-host
KAFKA_PORT=your-aiven-port
KAFKA_USERNAME=your-aiven-username
KAFKA_PASSWORD=your-aiven-password
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# Paste the PEM as a single line with \n separators or as a multiline value if your env manager supports it
KAFKA_SSL_CA_CERT=your-aiven-ca-certificate
KAFKA_CONSUMER_GROUP_ID=iam-service
SERVER_PORT=8080
GATEWAY_PORT=8081
IAM_PORT=8080
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_SCOPES=openid,email,profile
IAM_DEPLOY_URL=http://localhost:8080
